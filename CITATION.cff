# Lets GitHub show "Cite this repository". Fill in the authors and, after the
# first release archived on Zenodo, the version DOI. Keep `version` equal to
# the version in pyproject.toml (a test checks this).
cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: "mito-seg"
abstract: "Fiji scripts for segmenting mitochondria in FIB-SEM volumes."
type: software
authors:
  - family-names: "Jones"
    given-names: "Martin"
    email: "martin.jones@crick.ac.uk"
    affiliation: "The Francis Crick Institute"
version: "0.0.0"
license: BSD-3-Clause
repository-code: "https://github.com/martlj/test-1"
